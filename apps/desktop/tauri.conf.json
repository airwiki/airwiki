{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirWiki",
  "mainBinaryName": "airwiki",
  "version": "0.2.0",
  "identifier": "io.github.airwiki.AirWiki",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "AirWiki",
        "width": 1180,
        "height": 760,
        "minWidth": 1020,
        "minHeight": 640,
        "visible": false,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": false,
    "publisher": "AirWiki",
    "homepage": "https://github.com/airwiki/airwiki",
    "copyright": "Copyright 2026 AirWiki contributors",
    "category": "Productivity",
    "shortDescription": "Local-first, human-reviewed knowledge desktop",
    "longDescription": "Curate local documents into reviewed knowledge and optionally search authorized evidence across nearby devices.",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "createUpdaterArtifacts": false,
    "icon": [
      "../../resources/branding/airwiki.icns",
      "../../resources/branding/airwiki.ico"
    ]
  }
}
