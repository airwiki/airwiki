{
  "name": "@airwiki/desktop-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:e2e": "tsc --project e2e/tsconfig.json",
    "e2e": "pnpm build:e2e && node scripts/run-e2e.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "licenses:check": "node scripts/license-inventory.mjs --check",
    "licenses:generate": "node scripts/license-inventory.mjs --generate"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "@lucide/svelte": "1.30.0",
    "@tauri-apps/api": "2.11.1",
    "cytoscape": "3.34.0",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/svelte": "5.4.2",
    "@types/mocha": "10.0.10",
    "@types/node": "26.2.0",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/types": "9.30.1",
    "@wdio/visual-service": "9.3.0",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "svelte-check": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
