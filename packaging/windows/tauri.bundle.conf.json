{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "icon": ["../../resources/branding/airwiki.ico"],
    "resources": {
      "../../resources/llama/windows-x64/": "llama/",
      "../../target/x86_64-pc-windows-msvc/release/airwiki-mcp-bridge.exe": "integrations/bridge/airwiki-mcp-bridge.exe",
      "../../target/x86_64-pc-windows-msvc/release/airwiki-windows-firewall-helper.exe": "airwiki-windows-firewall-helper.exe",
      "../../target/mcpb/x86_64-pc-windows-msvc/airwiki-claude.mcpb": "integrations/airwiki-claude.mcpb",
      "../../resources/integrations/workflow/": "integrations/workflow/",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../LICENSE": "LICENSE",
      "../../resources/licenses/": "licenses/"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "installerIcon": "../../resources/branding/airwiki.ico",
        "uninstallerIcon": "../../resources/branding/airwiki.ico",
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true,
        "template": "../../packaging/windows/installer.nsi"
      }
    }
  }
}
