{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "icon": ["../../resources/branding/airwiki.ico"],
    "resources": {
      "../../target/validated-windows-bundle/staging/llama/": "llama/",
      "../../target/validated-windows-bundle/staging/airwiki-mcp-bridge.exe": "integrations/bridge/airwiki-mcp-bridge.exe",
      "../../target/validated-windows-bundle/staging/airwiki-windows-firewall-helper.exe": "airwiki-windows-firewall-helper.exe",
      "../../resources/integrations/workflow/": "integrations/workflow/"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "installerIcon": "../../resources/branding/airwiki.ico",
        "uninstallerIcon": "../../resources/branding/airwiki.ico",
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true,
        "template": "../../packaging/windows/installer.nsi"
      }
    }
  }
}
