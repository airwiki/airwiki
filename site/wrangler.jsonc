{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "airwiki-launch-preview",
  "compatibility_date": "2026-05-22",
  "main": "./src/index.ts",
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/*"]
  }
}
