{
  "compilerOptions": {
    "lib": ["ES2024", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
